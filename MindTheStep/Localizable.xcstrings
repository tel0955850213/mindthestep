    },
    "largest drop": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最大落差"
          }
        }
      }
    },
    "staircases": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "樓梯"
          }
        }
      }
    },
    "LiDAR vs tape measure: ±%@ cm average over %lld checks": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "LiDAR 與捲尺平均誤差 ±%@ 公分（%lld 次驗證）"
          }
        }
      }
    },
    "new": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新"
          }
