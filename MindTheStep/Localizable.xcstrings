            "value": "LiDAR 誤差"
          }
        }
      }
    },
    "Validate": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "驗證"
          }
        }
      }
    },
    "Measure the real step with a tape to check the LiDAR reading.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用捲尺量實際高度，檢查 LiDAR 的讀數。"
          }
        }
      }
    },
    "over 15 cm": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "超過 15 公分"
          }
        }
      }
    },
    "8–15 cm": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "8–15 公分"
          }
        }
      }
    },
    "%lld saved": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已存 %lld 筆"
          }
        }
      }
    },
    "Hazard map": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "落差地圖"
          }
        }
      }
    },
    "Daughter": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "女兒"
          }
        }
      }
    },
    "now": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "現在"
          }
        }
      }
    },
    "Name": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "名稱"
          }
        }
      }
    },
    "Who gets alerts": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "誰會收到通知"
          }
        }
      }
    },
    "Auto-notify family": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動通知家人"
          }
        }
      }
    },
    "For steps ≥ %lld cm": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "台階 ≥ %lld 公分時通知"
          }
        }
      }
    },
    "Sends the step type, height and time only. No location or photo. At most one alert every 30 seconds.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只傳送台階類型、高度和時間，不含位置和照片。每 30 秒最多一則。"
          }
        }
      }
    },
    "Channel": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "頻道"
          }
        }
      }
    },
    "Open this link (or subscribe in the free ntfy app) to get MindTheStep alerts.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開這個連結（或在免費的 ntfy App 訂閱），就能收到小心台階的通知。"
          }
        }
      }
    },
    "Send setup link to %@": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "傳設定連結給%@"
          }
        }
      }
    },
    "Send test alert": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "傳送測試通知"
          }
        }
      }
    },
    "Delivery": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "傳送方式"
          }
        }
