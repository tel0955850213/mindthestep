          }
        }
      }
    },
    "Warned at": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒距離"
          }
        }
      }
    },
    "Time": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "時間"
          }
        }
      }
    },
    "Is it real?": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "是真的嗎？"
          }
        }
      }
    },
    "Unreviewed": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未確認"
          }
        }
      }
