{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "An early warning for steps and drops ahead of you.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在你走到台階前，先提醒你。"
          }
        }
      }
    },
    "MindTheStep is an awareness aid, not a medical device. It does not replace a cane, a companion, or your own attention.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "小心台階是提醒工具，不是醫療器材，不能取代拐杖、陪伴的人，或你自己的注意力。"
          }
        }
      }
    },
    "Start walking": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開始走路"
          }
        }
      }
    },
    "Hold at chest height": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掛在胸前"
          }
        }
      }
    },
    "Tilt the phone forward so the camera sees the ground 1–2 m ahead. A cane clip or lanyard works well.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手機稍微往前傾，讓鏡頭看到前方 1–2 公尺的地面。用掛繩或拐杖夾都可以。"
          }
        }
      }
    },
    "Feel it, hear it": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "震動加語音"
          }
        }
      }
    },
    "A buzz and a short voice cue warn you before you reach a step. Works without internet.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "走到台階前，手機會震動並用語音提醒你。不需要網路。"
          }
        }
      }
    },
    "Keep family in the loop": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓家人放心"
          }
        }
      }
    },
    "Big steps can notify a family member. Only the step size and time are sent, never your location.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遇到較高的台階時可以通知家人，只會傳送台階高度和時間，不會傳送你的位置。"
          }
        }
      }
    },
    "Detect": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "偵測"
          }
        }
      }
    },
    "Report": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "報告"
          }
        }
      }
    },
    "Map": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "地圖"
          }
        }
      }
    },
    "Family": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "家人"
          }
        }
      }
    },
    "LiDAR running at %lld frames per second": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "LiDAR 每秒 %lld 張"
          }
        }
      }
    },
    "Mute voice": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉語音"
          }
        }
      }
    },
    "Unmute voice": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟語音"
          }
        }
      }
    },
    "Hide diagnostics": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隱藏診斷資訊"
          }
        }
      }
    },
    "Show diagnostics": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示診斷資訊"
          }
        }
      }
    },
    "This iPhone has no LiDAR.\nMindTheStep needs an iPhone Pro (12 Pro or later).": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這支 iPhone 沒有 LiDAR。\n小心台階需要 iPhone Pro（12 Pro 以後的機型）。"
          }
        }
      }
    },
    "Alert at ≥ %lld cm": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "落差 ≥ %lld 公分才警示"
          }
        }
      }
    },
    "GROUND AHEAD · 0.3–2.5 m · ±40 cm": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "前方地面 · 0.3–2.5 公尺 · ±40 公分"
          }
        }
      }
    },
    "on-device LiDAR · no cloud": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置上的 LiDAR · 不用雲端"
          }
        }
      }
    },
    "Stairs down": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "樓梯往下"
          }
        }
      }
    },
    "Stairs up": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "樓梯往上"
          }
        }
      }
    },
    "Step down": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "往下一階"
          }
        }
      }
    },
    "Step up": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "往上一階"
          }
        }
      }
    },
    "%lld cm": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 公分"
          }
        }
      }
    },
    "%@ m ahead": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "前方 %@ 公尺"
          }
        }
      }
    },
    "Ramp up": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上坡"
          }
        }
      }
    },
    "Ramp down": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下坡"
          }
        }
      }
    },
    "Gentle slope ahead": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "前方是緩坡"
          }
        }
      }
    },
    "Tilt phone forward": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手機往前傾"
          }
        }
      }
    },
    "Can't see the ground": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "看不到地面"
          }
        }
      }
    },
    "Aim about 1–2 m ahead of your feet": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對準腳前 1–2 公尺"
          }
        }
      }
    },
    "Path clear": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "路面平坦"
          }
        }
      }
    },
    "Level ground ahead": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "前方是平地"
          }
        }
      }
    },
    "Can't see the ground ahead": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "看不到前方地面"
          }
        }
      }
    },
    "Hold the phone at chest height": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請把手機拿到胸口高度"
          }
        }
      }
    },
    "Not enough ground points": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "地面資訊不足"
          }
        }
      }
    },
    "Obstacle ahead": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "前方有障礙物"
          }
        }
      }
    },
    "Large drop or obstacle ahead": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "前方有較大落差或障礙物"
          }
        }
      }
    },
    "Edge partly hidden": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "邊緣部分被遮住"
          }
        }
      }
    },
    "Waiting for depth": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等待深度資料"
          }
        }
      }
    },
    "Ground not visible past %@ m": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "看不到 %@ 公尺外的地面"
          }
        }
      }
    },
    "MindTheStep walk summary": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "小心台階 步行摘要"
          }
        }
      }
    },
    "Share report with family": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分享報告給家人"
          }
        }
      }
    },
    "No hazards yet": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有紀錄"
          }
        }
      }
    },
    "Steps and drops you pass are saved here automatically.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "走過的台階和落差會自動存在這裡。"
          }
        }
      }
    },
    "Confirm": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確認"
          }
        }
      }
    },
    "Not real": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "誤判"
          }
        }
      }
    },
    "Delete": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除"
          }
        }
      }
    },
    "Hazards": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "落差紀錄"
          }
        }
      }
    },
    "Swipe right to confirm, left for a false alarm. Tap one to check it against a tape measure.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "往右滑確認，往左滑標為誤判。點進去可以用捲尺驗證。"
          }
        }
      }
    },
    "Start a new walk": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開始新的步行"
          }
        }
      }
    },
    "Clear all hazards": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清除所有紀錄"
          }
        }
      }
    },
    "Location and photos stay on this iPhone unless you share them.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "位置和照片只存在這支 iPhone，除非你主動分享。"
          }
        }
      }
    },
    "Delete every saved hazard and photo?": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要刪除所有紀錄和照片嗎？"
          }
        }
      }
    },
    "Delete all": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "全部刪除"
          }
        }
      }
    },
    "Today's walk": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天的步行"
          }
        }
      }
    },
    "Measured on-device with iPhone LiDAR · MindTheStep": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由 iPhone LiDAR 在裝置上量測 · 小心台階"
          }
        }
      }
    },
    "steps & drops": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "台階與落差"
