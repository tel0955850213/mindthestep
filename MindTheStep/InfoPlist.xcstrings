    "CFBundleName": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MindTheStep"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "小心台階"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MindTheStep uses the camera and LiDAR to detect steps and drop-offs ahead of you."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "小心台階使用相機和 LiDAR 偵測你前方的台階和落差。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MindTheStep pins each step or drop you pass so you can review it later. Location stays on your iPhone unless you share a summary."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "小心台階會標記你經過的每個台階和落差位置，方便之後查看。位置只存在你的 iPhone，除非你分享摘要。"
          }
        }
      }
    }
  }
}